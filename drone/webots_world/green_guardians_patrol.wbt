    "Green Guardians patrol demo: DJI Mavic 2 PRO flying over a rural area."
    "Controlled by drone/drone_controller.py via an extern Webots controller."
  ]
  title "Green Guardians Patrol"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
