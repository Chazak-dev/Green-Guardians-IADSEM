# Smoke without visible flame (smoldering ground + drifting smoke, no fire
# geometry at all) - "smoke without visible fire" category, important for
# early wildfire detection.
Solid {
  translation -13 -16 0
  name "smoke_only"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.12 0.1
        roughness 1
        metalness 0
