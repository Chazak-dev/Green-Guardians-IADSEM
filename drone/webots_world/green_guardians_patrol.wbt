# -----------------------------------------------------------------------------
# AI training dataset scenarios (Person 2's fire/smoke detector).
# fire_target above is the "medium fire" baseline. These add the other sizes/
# cases a real dataset needs: small fire, a large multi-tree blaze, three
# separate fires (a scattered-fire scenario), and a smoke-only smolder with
# no visible flame (for early-detection training). Spread a few dozen metres
# apart so a capture pass can visit each independently without one bleeding
# into another's frame. Not attempting weather/fog/night lighting here -
# vanilla Webots doesn't support those without substantial custom VFX work,
# which is out of scope for this project.
# -----------------------------------------------------------------------------

# Small fire (~0.5x fire_target's scale) - "small fire" category.
Solid {
  translation -13.8 -11.6 0
  name "fire_small"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.05 0.05
        roughness 1
        metalness 0
      }
      geometry Cylinder {
        radius 0.3
        height 0.02
      }
    }
    Transform {
      translation 0 0 0.025
