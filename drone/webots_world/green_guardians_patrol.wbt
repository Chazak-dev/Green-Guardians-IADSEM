  randomSeed 1
  maxHeight 12
  minHeight 6
  maxRadius 6
  minRadius 3
}
Mavic2Pro {
  translation 0 0 0.1
  rotation 0 0 1 3.141590777218456
  controller "<extern>"
  cameraSlot [
    Camera {
      width 640
      height 480
      near 0.2
    }
  ]
}
