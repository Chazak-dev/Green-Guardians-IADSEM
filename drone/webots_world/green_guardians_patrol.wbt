        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.25 0.05
            emissiveColor 0.9 0.25 0.02
            roughness 0.4
            metalness 0
          }
          geometry Cone {
            bottomRadius 0.18
            height 0.35
          }
        }
      ]
    }
    Transform {
      translation 0 0 0.175
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 0.5 0.05
            emissiveColor 1 0.45 0.03
            roughness 0.4
            metalness 0
          }
          geometry Cone {
            bottomRadius 0.11
            height 0.3
          }
        }
      ]
    }
    Transform {
      translation 0 0 0.31
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 0.85 0.2
            emissiveColor 1 0.8 0.15
            roughness 0.4
          }
          geometry Cone {
            bottomRadius 0.05
            height 0.18
          }
        }
      ]
    }
    Transform {
      translation 0.05 0.03 0.65
