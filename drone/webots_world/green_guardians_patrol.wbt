        radius 0.5
        height 0.02
      }
    }
    Transform {
      translation 0.1 0.05 0.5
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.55 0.55 0.55
            transparency 0.4
            roughness 1
          }
          geometry Sphere {
            radius 0.35
          }
        }
      ]
    }
    Transform {
      translation -0.1 0.1 0.9
