          appearance PBRAppearance {
            baseColor 0.5 0.5 0.5
            transparency 0.55
            roughness 1
          }
          geometry Sphere {
            radius 0.22
          }
        }
      ]
    }
  ]
}
PointLight {
  attenuation 0 0 1
  color 1 0.5 0.1
  intensity 1.5
  location -13.8 -11.6 0.4
