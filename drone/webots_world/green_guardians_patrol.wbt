            transparency 0.7
            roughness 1
          }
          geometry Sphere {
            radius 0.6
          }
        }
      ]
    }
  ]
}

# False positives: things that might read as fire to a naive color/brightness
# detector but aren't - "false positives" category, teaches the model what
# to ignore. Plain, non-emissive rock (not fire-colored, just warm-toned) and
# a small bright warm-white glare/reflection (bright and warm-lit like a
# light source, but white-ish rather than orange, and not flame-shaped).
Solid {
  translation -9 -15 0
  name "false_positive_rock"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.35 0.2
        roughness 0.9
        metalness 0.1
      }
      geometry Sphere {
        radius 0.6
      }
    }
  ]
}
Solid {
  translation -18 -4 0
  name "false_positive_glare"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 1 0.85
        emissiveColor 0.9 0.9 0.7
        roughness 0.2
        metalness 0.6
      }
      geometry Sphere {
        radius 0.3
      }
    }
  ]
}
PointLight {
  attenuation 0 0 1
  color 1 1 0.9
  intensity 2
  location -18 -4 0.5
  radius 3
}
# =============================================================================
# Round-2 dataset collection zones (drone/dataset_collection_round2.py).
# 9 isolated hazard sites, each >=25m from every other and from the round-1
# fire_target/fire_small/fire_large/fire_multi/smoke_only cluster near base,
# so no two hazards - old or new - can ever appear in the same frame. Each
# hazard is offset ~9m from its flight waypoint (not on top of it), matching
# the standoff distance mission.py's fire_observation needed to keep the
# subject in frame at the camera's fixed downward pitch.
# =============================================================================
Solid {
  translation -1 -29 0
  name "fire_medium_zone"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.05 0.05
        roughness 1
        metalness 0
      }
      geometry Cylinder {
        height 0.03
        radius 0.7
      }
    }
    Transform {
      translation 0 0 0.05
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.25 0.05
            emissiveColor 0.9 0.25 0.02
            roughness 0.4
            metalness 0
          }
          geometry Cone {
            bottomRadius 0.4
            height 0.8
          }
        }
      ]
    }
    Transform {
      translation 0.05 0.03 0.4
